# --- Supabase ---
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_secret_key_here
SUPABASE_BUCKET=broker-agent

# Postgres access via Supavisor transaction pooler (port 6543)
SUPABASE_PW=your_database_password_here
SUPABASE_DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=6543

# --- Groq (STT + LLM analysis) ---
GROQ_API_KEY=your_groq_api_key_here
WHISPER_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-120b

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Pipeline tuning ---
CHECK_INTERVAL=120
CHUNK_SECONDS=300
CAPTURE_CONCURRENCY=3
STT_MAX_ATTEMPTS=3
ANALYZE_WITH_LLM=true
NOTIFY_TELEGRAM=true
# Optional: seed sources at scanner startup (comma separated)
SOURCE_HANDLES=
